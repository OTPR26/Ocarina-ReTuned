if(APPLE)
    enable_language(OBJCXX)
    set(RETUNED_ICLOUD_CONTAINER "" CACHE STRING "Provisioned CloudKit container; empty keeps sync offline")
    target_sources(oot3d_native_game PRIVATE "${CMAKE_CURRENT_LIST_DIR}/save_sync.mm")
    set_source_files_properties("${CMAKE_CURRENT_LIST_DIR}/save_sync.mm" PROPERTIES COMPILE_FLAGS "-fobjc-arc")
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        target_sources(oot3d_native_game PRIVATE "${CMAKE_CURRENT_LIST_DIR}/macos_launcher.cpp")
        target_compile_definitions(oot3d_native_game PRIVATE RETUNED_MAC_APP=1)
    endif()
    target_compile_definitions(oot3d_native_game PRIVATE RETUNED_ICLOUD_CONTAINER="${RETUNED_ICLOUD_CONTAINER}")
    target_link_libraries(oot3d_native_game PRIVATE "-framework Foundation" "-framework CloudKit" "-framework Security")
endif()
