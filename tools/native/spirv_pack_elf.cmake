# GNU ELF assemblers can embed binary packs without parsing millions of C++
# integer literals. This preserves the same aligned bytes and ReadSpirvPack API.
function(triaevum_add_spirv_pack target source pack)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR TRIAEVUM_CXX_HAS_EMBED)
        retuned_literal_add_spirv_pack(${target} "${source}" "${pack}")
        return()
    endif()
    get_filename_component(source "${source}" ABSOLUTE)
    get_filename_component(pack "${pack}" ABSOLUTE)
    if(pack MATCHES "[\"\n\r\\\\]")
        message(FATAL_ERROR "Unsupported binary-pack path characters")
    endif()
    file(READ "${source}" content)
    set(begin "TRIAEVUM_SPIRV_PACK_EMBED_BEGIN")
    set(end "TRIAEVUM_SPIRV_PACK_EMBED_END")
    string(FIND "${content}" "${begin}" first)
    string(FIND "${content}" "${end}" last)
    if(first LESS 0 OR last LESS first OR NOT content MATCHES "const unsigned char kPack\\[\\]")
        message(FATAL_ERROR "Unexpected SPIR-V pack embedding source: ${source}")
    endif()
    string(SUBSTRING "${content}" 0 ${first} prefix)
    string(LENGTH "${end}" length)
    math(EXPR after "${last} + ${length}")
    string(SUBSTRING "${content}" ${after} -1 suffix)
    string(SHA256 id "${target}:${pack}")
    set(symbol "retuned_spirv_${id}")
    file(SIZE "${pack}" bytes)
    set(payload "extern \"C\" const unsigned char ${symbol}[];\n")
    string(APPEND payload "asm(\".pushsection .rodata.${symbol},\\\"a\\\",%progbits\\n\"\n")
    string(APPEND payload "    \".balign 16\\n.global ${symbol}\\n.hidden ${symbol}\\n${symbol}:\\n\"\n")
    string(APPEND payload "    \".incbin \\\"${pack}\\\"\\n.popsection\\n\");\n")
    string(APPEND payload "const std::span<const unsigned char> kPack{${symbol}, ${bytes}};\n")
    set(directory "${CMAKE_BINARY_DIR}/spirv_pack_objects")
    file(MAKE_DIRECTORY "${directory}")
    set(wrapper "${directory}/${id}.cpp")
    set(generated "${prefix}${payload}${suffix}")
    if(EXISTS "${wrapper}")
        file(READ "${wrapper}" previous)
    else()
        set(previous "")
    endif()
    if(NOT previous STREQUAL generated)
        file(WRITE "${wrapper}" "${generated}")
    endif()
    target_sources(${target} PRIVATE "${wrapper}")
    get_filename_component(source_directory "${source}" DIRECTORY)
    set_property(SOURCE "${wrapper}" TARGET_DIRECTORY ${target} APPEND PROPERTY
        INCLUDE_DIRECTORIES "${source_directory}")
    set_property(SOURCE "${wrapper}" TARGET_DIRECTORY ${target} APPEND PROPERTY
        OBJECT_DEPENDS "${source};${pack}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source};${pack}")
endfunction()
