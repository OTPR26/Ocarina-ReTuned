if(NOT ANDROID AND (WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR CMAKE_SYSTEM_NAME STREQUAL "Linux"))
    find_package(OpenGL REQUIRED)
    target_sources(oot3d_native_game PRIVATE "${CMAKE_CURRENT_LIST_DIR}/first_run.cpp")
    target_include_directories(oot3d_native_game PRIVATE "${CMAKE_CURRENT_LIST_DIR}")
    target_compile_definitions(oot3d_native_game PRIVATE RETUNED_DESKTOP_SETUP=1)
    target_link_libraries(oot3d_native_game PRIVATE ImGui SDL2::SDL2 OpenGL::GL)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        find_package(GLEW REQUIRED)
        target_link_libraries(oot3d_native_game PRIVATE GLEW::GLEW)
    endif()
    if(WIN32)
        target_link_libraries(oot3d_native_game PRIVATE comdlg32)
    endif()
endif()
