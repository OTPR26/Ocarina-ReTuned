diff --git a/runtime/three_ds_recomp/src/ship/Context.cpp b/runtime/three_ds_recomp/src/ship/Context.cpp
--- a/runtime/three_ds_recomp/src/ship/Context.cpp
+++ b/runtime/three_ds_recomp/src/ship/Context.cpp
@@ -341,7 +341,15 @@ bool Context::InitWindow(std::shared_ptr<Window> window) {
         return false;
     }
 
-    GetWindow()->Init();
+    try {
+        GetWindow()->Init();
+    } catch (...) {
+        // The window never became usable: do not keep it as the context's
+        // window, or the destructor would save its geometry and tear down
+        // backends that were never created.
+        mWindow = nullptr;
+        throw;
+    }
 
     return true;
 }
diff --git a/runtime/three_ds_recomp/src/ship/window/gui/Gui.cpp b/runtime/three_ds_recomp/src/ship/window/gui/Gui.cpp
