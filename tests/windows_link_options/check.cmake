cmake_minimum_required(VERSION 3.20)
# Exercise the actual upstream game target's linker-condition block.
file(READ "${GAME_CMAKE}" source)
string(FIND "${source}" "if (OOT3D_WHOLE_AOT_PRODUCT_MODE)\n    target_link_libraries(oot3d_native_game PRIVATE\n        oot3d_native_crash_diagnostics)" start)
string(FIND "${source}" "option(TRIAEVUM_ENABLE_CPU_PHASE_PROBE" end)
if(start LESS 0 OR end LESS start)
    message(FATAL_ERROR "Game linker block changed")
endif()
math(EXPR length "${end}-${start}")
string(SUBSTRING "${source}" ${start} ${length} block)
function(target_link_libraries)
endfunction()
function(target_compile_definitions)
endfunction()
function(target_link_options)
    set_property(GLOBAL APPEND PROPERTY captured "${ARGN}")
endfunction()
set(OOT3D_WHOLE_AOT_PRODUCT_MODE ON)
set(CMAKE_SYSTEM_NAME Windows)
foreach(driver IN ITEMS portable msvc)
    if(driver STREQUAL msvc)
        set(MSVC TRUE)
    else()
        set(MSVC FALSE)
    endif()
    foreach(fast IN ITEMS OFF ON)
        set(OOT3D_FAST_DEV_LINK ${fast})
        set_property(GLOBAL PROPERTY captured "")
        cmake_language(EVAL CODE "${block}")
        get_property(flags GLOBAL PROPERTY captured)
        if(NOT MSVC AND flags)
            message(FATAL_ERROR "Portable driver received MSVC options: ${flags}")
        elseif(MSVC AND fast AND NOT "/DEBUG:NONE" IN_LIST flags)
            message(FATAL_ERROR "MSVC fast-link flags lost")
        elseif(MSVC AND NOT fast AND NOT "/DEBUG:FULL" IN_LIST flags)
            message(FATAL_ERROR "MSVC symbol flags lost")
        endif()
    endforeach()
endforeach()
message(STATUS "Windows driver linker scope passed")
